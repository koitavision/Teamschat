# Clé API Mistral (https://console.mistral.ai) — ne jamais committer le vrai .env
MISTRAL_API_KEY=change-me
# Modèle utilisé par l'agent (optionnel)
MISTRAL_MODEL=mistral-small-latest
# Port du serveur en local (optionnel)
# PORT=3000
# Mode test sans appel réseau : AGENT_MOCK=1

# Persistance durable (Vercel KV / Upstash) — sur Vercel, ces deux variables
# sont injectées automatiquement quand tu connectes une base KV au projet.
# En local, laisser vide => stockage fichier dans data/
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
