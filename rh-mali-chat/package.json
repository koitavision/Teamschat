{
  "name": "rh-mali-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Chat web minimal (TypeScript + SDK Mistral officiel) : assistant RH spécialisé droit du travail malien",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node tests/smoke.mjs"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
